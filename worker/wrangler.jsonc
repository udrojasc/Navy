{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "navy",
  "main": "src/index.js",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "preview_urls": false,
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionStore"]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "SessionStore"
      }
    ]
  },
  "vars": {
    "ALLOWED_HOSTS": "example.com,udrojasc.github.io,navy.ulisesdrojasc2.workers.dev,fonts.googleapis.com,fonts.gstatic.com,ws.postman-echo.com",
    "MAX_BODY_BYTES": "8388608",
    "MAX_REDIRECTS": "8",
    "SESSION_TTL_SECONDS": "7200"
  }
}
