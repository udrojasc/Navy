{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "navy",
  "main": "src/index.js",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "preview_urls": false,
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionStore"]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "SessionStore"
      }
    ]
  },
  "vars": {
    "ALLOWED_HOSTS": "example.com,udrojasc.github.io,navy.ulisesdrojasc2.workers.dev,fonts.googleapis.com,fonts.gstatic.com,echo.websocket.org,google.com,www.google.com,mozilla.org,www.mozilla.org,firefox.com,www.firefox.com,docs.google.com,*.docs.google.com,*.c.docs.google.com,accounts.google.com,drive.google.com,*.drive.google.com,drive.usercontent.google.com,drive-data-export.usercontent.google.com,drive-data-export-eu.usercontent.google.com,sheets.google.com,script.google.com,apis.google.com,*.googleapis.com,*.googleusercontent.com,*.gstatic.com,*.gvt1.com,ssl.gstatic.com,www.gstatic.com,gg.google.com,inputtools.google.com,clients0.google.com,clients1.google.com,clients2.google.com,clients3.google.com,clients4.google.com,clients5.google.com,clients6.google.com,clients7.google.com,clients8.google.com,clients9.google.com",
    "MAX_BODY_BYTES": "8388608",
    "MAX_REDIRECTS": "8",
    "SESSION_TTL_SECONDS": "7200"
  }
}
